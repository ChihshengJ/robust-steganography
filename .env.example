# Copy to .env and fill in. Loaded automatically on `import systems`
# (see src/systems/env.py) — no python-dotenv needed. `export ` is optional.

# --- Required ----------------------------------------------------------------
# Generation, decoding, paraphrase/translation attacks (all phases).
export OPENAI_API_KEY="replace_me"

# --- Optional: extra stegoanalysis signals (Phase 2c) ------------------------
# LLM-as-judge detector (phase2c_llm_judge.py), routed through OpenRouter.
export OPENROUTER_API_KEY="replace_me"
# Google text-embedding-005 baseline (phase2c_embeddings.py, --models google).
# Skip if you only run the Qwen3 embedding model.
export GOOGLE_API_KEY="replace_me"

# --- Optional: regenerating the LitReview corpus -----------------------------
# Only needed to re-scrape data/litreview/ via semantic_scholar_requests.py.
# The shipped corpus already lets you run everything without this.
export SEMANTIC_SCHOLAR_API_KEY="replace_me"

# --- Optional: local llama.cpp server (TopicQA / Story only) -----------------
# Defaults match experiments/serve_local_model.sh. Override to point at a
# different host/port or GGUF. LOCAL_MODEL must equal the basename of the GGUF
# you serve (the alias llama-server reports on /v1/models).
# export LOCAL_BASE_URL="http://127.0.0.1:8080/v1"
# export LOCAL_MODEL="Qwen3.5-4B-UD-Q8_K_XL.gguf"
